{
  "name": "planrails",
  "version": "0.2.0",
  "description": "Plans that survive a lost session, and \"done\" that means done. A planner prompt and a tiny checker. No install.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/vivmagarwal/planrails.git" },
  "homepage": "https://github.com/vivmagarwal/planrails#readme",
  "bugs": { "url": "https://github.com/vivmagarwal/planrails/issues" },
  "keywords": ["planning", "claude-code", "agents", "llm", "compaction", "tracker"],
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test tools/check-plans.test.mjs",
    "check": "node tools/check-plans.mjs --root examples/weekly-digest && node --test tools/check-plans.test.mjs"
  }
}
